{
  "name": "justmdviewer-icon-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Regenerates the JustMdViewer logo, wordmark, app icon (.ico/.png) and site favicons from source geometry.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node generate.mjs",
    "preview": "node generate.mjs --preview preview",
    "verify": "node verify-ico.mjs ../../assets/icon/JustMdViewer.ico ../../docs/favicon.ico"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "opentype.js": "1.3.4",
    "sharp": "0.35.5"
  }
}
