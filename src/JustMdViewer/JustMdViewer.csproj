<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>JustMdViewer</AssemblyName>
    <RootNamespace>JustMdViewer</RootNamespace>
    <AssemblyTitle>JustMdViewer</AssemblyTitle>

    <!-- Read by ApplicationConfiguration.Initialize(). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>

    <!-- Framework-dependent (never self-contained): needs the .NET 10 Desktop Runtime and the
         Edge WebView2 Runtime. The release build/installer publishes a single win-x64 package;
         arm64 PCs run it under x64 emulation. A plain `dotnet publish` without -r stays AnyCPU
         and also ships the WebView2 loader for each architecture under runtimes\. -->
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Don't ship the WebView2 IntelliSense XML files. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- The icon is produced separately; build without it if it is not there yet. -->
  <PropertyGroup Condition="Exists('..\..\assets\icon\JustMdViewer.ico')">
    <ApplicationIcon>..\..\assets\icon\JustMdViewer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustMdViewer.Core\JustMdViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF wrapper on .NET 5+; this app is WinForms
       only, so drop it (avoids a WindowsBase version conflict warning and a useless DLL). -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
